---
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import fonteTitulo from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlutuante from '../components/WhatsAppFlutuante.astro';
import { getSite } from '../lib/utils';
import { resolverImagem } from '../lib/imagens';
import { schemaOrganizacao, schemaWebSite } from '../lib/schema';

interface Props {
  titulo: string;
  descricao: string;
  imagem?: string;
  tipoOg?: 'website' | 'article';
  noindex?: boolean;
  schema?: object[];
  /** mensagem pré-preenchida do WhatsApp nesta página */
  whatsappTexto?: string;
  /** nome do produto, enviado no evento click_whatsapp */
  produto?: string;
  tipoProduto?: 'viagem' | 'treinamento' | 'post' | 'pagina';
  /** imagem do hero para preload (LCP) */
  preloadImagem?: string;
}

const {
  titulo, descricao, imagem, tipoOg = 'website', noindex = false, schema = [],
  whatsappTexto, produto, tipoProduto = 'pagina', preloadImagem,
} = Astro.props;

const site = await getSite();
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Open Graph 1200×630: gera a partir da capa quando a imagem é local
let og = new URL('/og-padrao.jpg', Astro.site).href;
if (imagem) {
  const r = resolverImagem(imagem);
  if (typeof r === 'string') og = r;
  else {
    const o = await getImage({ src: r, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
    og = new URL(o.src, Astro.site).href;
  }
}
const preload = preloadImagem ? resolverImagem(preloadImagem) : undefined;

const grafo = {
  '@context': 'https://schema.org',
  '@graph': [schemaOrganizacao(site, Astro.site!), schemaWebSite(Astro.site!), ...schema],
};
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#1b2a54" />

  <meta property="og:type" content={tipoOg} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content="KeepTrack 4x4" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={titulo} />
  <meta name="twitter:description" content={descricao} />
  <meta name="twitter:image" content={og} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="Blog KeepTrack 4x4" href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <link rel="preload" href={fonteTitulo} as="font" type="font/woff2" crossorigin />
  {typeof preload === 'string' && <link rel="preload" as="image" href={preload} fetchpriority="high" />}

  <!-- Consent Mode v2: tudo negado até o visitante escolher (antes de qualquer tag) -->
  <script is:inline define:vars={{ gtm: site.gtmId }}>
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('consent', 'default', {
      ad_storage: 'denied', analytics_storage: 'denied',
      ad_user_data: 'denied', ad_personalization: 'denied',
      functionality_storage: 'granted', security_storage: 'granted',
      wait_for_update: 500,
    });
    window.__KT_GTM = gtm;
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(grafo)} />
</head>
<body data-tipo={tipoProduto} data-produto={produto}>
  <Header whatsappTexto={whatsappTexto} rotuloProduto={produto} />
  <main id="conteudo">
    <slot />
  </main>
  <Footer />
  <WhatsAppFlutuante texto={whatsappTexto} produto={produto} />

  <script>
    // Eventos de conversão: qualquer elemento com data-track vira um evento no dataLayer
    const body = document.body;
    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
      if (!el) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: el.dataset.track,
        local: el.dataset.local,
        pagina: location.pathname,
        tipo_produto: body.dataset.tipo,
        produto: el.dataset.produto || body.dataset.produto,
      });
    });

    // view_item nas páginas de produto
    if (body.dataset.tipo === 'viagem' || body.dataset.tipo === 'treinamento') {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event: 'view_item', tipo_produto: body.dataset.tipo, produto: body.dataset.produto });
    }

    // scroll 75%
    let rolou = false;
    addEventListener('scroll', () => {
      if (rolou) return;
      const h = document.documentElement;
      if ((h.scrollTop + innerHeight) / h.scrollHeight >= 0.75) {
        rolou = true;
        window.dataLayer.push({ event: 'scroll_75', pagina: location.pathname });
      }
    }, { passive: true });

    // Banner de cookies: carrega quando o navegador estiver ocioso
    const iniciar = () => import('../scripts/consentimento');
    'requestIdleCallback' in window ? requestIdleCallback(iniciar, { timeout: 2500 }) : setTimeout(iniciar, 1500);
  </script>
</body>
</html>

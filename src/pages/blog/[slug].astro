---
import { getEntry, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Foto from '../../components/Foto.astro';
import RespostaDireta from '../../components/RespostaDireta.astro';
import FAQ from '../../components/FAQ.astro';
import CardViagem from '../../components/CardViagem.astro';
import CardTreinamento from '../../components/CardTreinamento.astro';
import CardPost from '../../components/CardPost.astro';
import CTAFinal from '../../components/CTAFinal.astro';
import { getPosts, dataLonga, rotulos, tempoLeitura } from '../../lib/utils';
import { schemaBreadcrumb, schemaPost, schemaFaq } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content } = await render(p);
const autor = (await getEntry(d.autor))!;
const viagens = await getEntries(d.relacionadosViagens);
const treinamentos = await getEntries(d.relacionadosTreinamentos);
const outros = (await getPosts()).filter((x) => x.id !== p.id).slice(0, 3);
const url = new URL(Astro.url.pathname, Astro.site).href;
const migalhas = [{ nome: 'Início', url: '/' }, { nome: 'Blog', url: '/blog/' }, { nome: d.titulo, url: Astro.url.pathname }];
const schema = [schemaBreadcrumb(migalhas, Astro.site!), schemaPost(p, autor.data, url, d.capa, Astro.site!), ...schemaFaq(d.faq)];
---
<BaseLayout titulo={d.seo.titulo} descricao={d.seo.descricao} imagem={d.capa} preloadImagem={d.capa} tipoOg="article" schema={schema} tipoProduto="post" produto={d.titulo}>
  <article>
    <header class="cab">
      <div class="estreito">
        <Breadcrumb itens={migalhas} />
        <p class="eyebrow">{rotulos.categoria[d.categoria]}</p>
        <h1>{d.titulo}</h1>
        <p class="meta">
          Por <a href="/a-keeptrack/#equipe">{autor.data.nome}</a> ·
          <time datetime={d.publicado.toISOString()}>{dataLonga(d.publicado)}</time>
          {d.atualizado && <> · atualizado em <time datetime={d.atualizado.toISOString()}>{dataLonga(d.atualizado)}</time></>}
          · {tempoLeitura(p.body)} min de leitura
        </p>
      </div>
      <div class="container capa"><Foto src={d.capa} alt={d.capaAlt} largura={1200} prioridade sizes="(max-width: 1200px) 100vw, 1200px" /></div>
    </header>

    <div class="estreito corpo">
      <RespostaDireta texto={d.resposta} rotulo="Resposta rápida" />
      <div class="prosa"><Content /></div>
      {d.faq.length > 0 && <section class="faq"><h2>Perguntas frequentes</h2><FAQ itens={d.faq} /></section>}
      <aside class="autor">
        <p class="eyebrow">Sobre o autor</p>
        <p><strong>{autor.data.nome}</strong> · {autor.data.cargo}. {autor.data.credenciais.join(' · ')}.</p>
      </aside>
    </div>
  </article>

  {(viagens.length > 0 || treinamentos.length > 0) && (
    <section class="secao secao--bege">
      <div class="container">
        <div class="cabecalho-secao"><div><p class="eyebrow">Na prática</p><h2>Viva isso com a KeepTrack</h2></div></div>
        <div class="grade">
          {treinamentos.map((t) => <CardTreinamento treinamento={t} />)}
          {viagens.map((v) => <CardViagem viagem={v} />)}
        </div>
      </div>
    </section>
  )}

  {outros.length > 0 && (
    <section class="secao">
      <div class="container">
        <div class="cabecalho-secao"><div><p class="eyebrow">Blog</p><h2>Continue lendo</h2></div></div>
        <div class="grade">{outros.map((o) => <CardPost post={o} />)}</div>
      </div>
    </section>
  )}
  <CTAFinal />
</BaseLayout>
<style>
  .cab { padding-top: clamp(32px, 5vw, 56px); }
  h1 { font-size: clamp(2.3rem, 5vw, 3.8rem); text-transform: none; letter-spacing: 0; }
  .meta { color: var(--cinza); font-size: .98rem; }
  .capa { margin-top: 2rem; aspect-ratio: 21 / 9; border-radius: var(--raio-g); overflow: hidden; background: var(--bege-2); }
  .capa :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .corpo { padding-block: clamp(40px, 5vw, 64px) var(--sec); }
  .corpo .prosa { margin-top: 2.5rem; }
  .faq { margin-top: 3.5rem; }
  .autor { margin-top: 3.5rem; padding: 1.5rem; border: 1px solid var(--linha); border-radius: var(--raio-g); }
  .autor p:last-child { margin: 0; }
  @media (max-width: 640px) { .capa { aspect-ratio: 4 / 3; width: 100%; border-radius: 0; } }
</style>

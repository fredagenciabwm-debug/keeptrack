---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import FaixaAutoridade from '../components/FaixaAutoridade.astro';
import CardTreinamento from '../components/CardTreinamento.astro';
import CardViagem from '../components/CardViagem.astro';
import CardPost from '../components/CardPost.astro';
import ListaTurmas from '../components/ListaTurmas.astro';
import Galeria from '../components/Galeria.astro';
import CTAFinal from '../components/CTAFinal.astro';
import { getSite, linkWhatsApp, getTreinamentos, getViagens, getPosts, agendaTurmas, diaMes } from '../lib/utils';

const site = await getSite();
const home = (await getEntry('home', 'home'))!.data;
const sobre = (await getEntry('sobre', 'a-keeptrack'))!.data;
const treinamentos = await getTreinamentos();
const { proximas, realizadas } = await getViagens();
const viagensVitrine = [...proximas, ...realizadas].slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
const agenda = (await agendaTurmas()).slice(0, 3);
const prox = agenda[0];
const proxDm = prox ? diaMes(prox.turma.data) : null;
const caio = (await getCollection('equipe')).sort((a, b) => a.data.ordem - b.data.ordem)[0];

const iconesPilares = ['escudo', 'ferramenta', 'rota'] as const;
---
<BaseLayout titulo={home.seo.titulo} descricao={home.seo.descricao} imagem={home.heroImagem} preloadImagem={home.heroImagem}>
  <!-- HERO ---------------------------------------------------------------->
  <section class="hero">
    <div class="hero-foto"><Foto src={home.heroImagem} alt={home.heroImagemAlt} largura={1600} prioridade /></div>
    <div class="container hero-conteudo">
      <p class="eyebrow eyebrow--claro">{home.heroEyebrow}</p>
      <h1>{home.heroTitulo}</h1>
      <p class="hero-sub">{home.heroSubtitulo}</p>
      <div class="hero-botoes">
        <a class="btn btn--wa" href={linkWhatsApp(site.whatsappPrincipal, site.whatsappTexto)} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="hero">
          <Icone nome="whatsapp" />Falar no WhatsApp
        </a>
        <a class="btn btn--contorno-claro" href="/treinamentos/">Ver treinamentos</a>
      </div>
      {prox && proxDm && (
        <a class="chip-turma" href={`/treinamentos/${prox.treinamento.id}/`}>
          <span class="chip-data"><strong>{proxDm.dia}</strong>{proxDm.mes}</span>
          <span><small>Próxima turma</small>{prox.treinamento.data.titulo} · {prox.turma.local ?? prox.treinamento.data.local}</span>
        </a>
      )}
    </div>
  </section>

  <section class="faixa-aut" aria-label="KeepTrack em números">
    <div class="container"><div class="faixa-card topo"><FaixaAutoridade numeros={home.numeros} /></div></div>
  </section>

  <!-- DOIS CAMINHOS --------------------------------------------------------->
  <section class="secao">
    <div class="container">
      <div class="cabecalho-secao">
        <div>
          <p class="eyebrow">O que fazemos</p>
          <h2>Aprenda a técnica. Depois, pegue a estrada.</h2>
        </div>
        <p>Dois jeitos de viver o off-road com a KeepTrack: no treinamento, em pista controlada, ou em expedições guiadas por alguns dos lugares mais bonitos do continente.</p>
      </div>
      <div class="caminhos">
        <a class="caminho" href="/treinamentos/">
          <Foto src="https://www.keeptrack.com.br/wp/wp-content/uploads/2026/01/keeptrack-treinamento-4@4x-1024x768.png" alt="Veículos 4x4 na pista de treinamento do Raceville" largura={800} sizes="(max-width: 820px) 100vw, 600px" />
          <div class="caminho-texto">
            <span class="caminho-num">01</span>
            <h3>Treinamentos 4x4</h3>
            <p>Técnicas de condução fora de estrada para iniciantes e experientes, em grupo, personalizado ou para empresas.</p>
            <span class="link-seta">Ver treinamentos</span>
            <span class="caminho-seta" aria-hidden="true"><Icone nome="seta" /></span>
          </div>
        </a>
        <a class="caminho" href="/viagens/">
          <Foto src="https://www.keeptrack.com.br/wp/wp-content/uploads/2023/01/keeptrack-jalapao-54.jpg" alt="Grupo da KeepTrack em fervedouro no Jalapão" largura={800} sizes="(max-width: 820px) 100vw, 600px" />
          <div class="caminho-texto">
            <span class="caminho-num">02</span>
            <h3>Viagens & Expedições</h3>
            <p>Roteiros off-road guiados pelo Brasil e pela América do Sul, com comboio, carro de apoio e equipe experiente.</p>
            <span class="link-seta">Ver viagens</span>
            <span class="caminho-seta" aria-hidden="true"><Icone nome="seta" /></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- TREINAMENTOS + AGENDA --------------------------------------------------->
  <section class="secao secao--bege">
    <div class="container">
      <div class="cabecalho-secao">
        <div>
          <p class="eyebrow">Treinamentos</p>
          <h2>Próximas turmas</h2>
        </div>
        <p>Um sábado no Raceville Speed Club, em Brotas-SP: 3 h de teoria e 3 h de prática em pista off-road com o seu próprio carro.</p>
      </div>
      <div class="agenda">
        <ListaTurmas
          turmas={agenda.map((a) => a.turma)}
          mostrarTreinamento={agenda.map((a) => a.treinamento.data.titulo)}
          localPadrao="Raceville Speed Club, Brotas-SP"
          titulo="Técnicas de Condução 4x4"
        />
      </div>
      <div class="grade">
        {treinamentos.map((t) => <CardTreinamento treinamento={t} />)}
      </div>
    </div>
  </section>

  <!-- PILARES / SEGURANÇA ----------------------------------------------------->
  <section class="secao secao--escura topo">
    <div class="container">
      <div class="cabecalho-secao">
        <div>
          <p class="eyebrow">Por que a KeepTrack</p>
          <h2>Segurança faz parte do roteiro</h2>
        </div>
        <p>Off-road é diversão quando tudo está sob controle. Por isso cada treinamento e cada expedição começam muito antes da trilha.</p>
      </div>
      <ul class="pilares">
        {home.pilares.map((p, i) => (
          <li>
            <span class="pilar-icone"><Icone nome={iconesPilares[i % 3]} /></span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ul>
      <div class="frota">
        <p class="frota-titulo">Equipamento que vai em toda expedição</p>
        <ul>{sobre.frota.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- VIAGENS ----------------------------------------------------------------->
  <section class="secao">
    <div class="container">
      <div class="cabecalho-secao">
        <div>
          <p class="eyebrow">Viagens & Expedições</p>
          <h2>{proximas.length ? 'Próximas viagens' : 'Por onde já passamos'}</h2>
        </div>
        <a class="link-seta" href="/viagens/">Todas as viagens</a>
      </div>
      {!proximas.length && (
        <div class="aviso-agenda">
          <Icone nome="bussola" />
          <p><strong>Calendário 2027 em preparação.</strong> As novas expedições saem primeiro para quem está na lista do WhatsApp.</p>
          <a class="btn btn--wa" href={linkWhatsApp(site.whatsappPrincipal, 'Olá! Quero ser avisado das próximas expedições da KeepTrack.')} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="lista-viagens">
            <Icone nome="whatsapp" />Quero ser avisado
          </a>
        </div>
      )}
      <div class="grade">
        {viagensVitrine.map((v) => <CardViagem viagem={v} />)}
      </div>
    </div>
  </section>

  <!-- GALERIA ------------------------------------------------------------------>
  <section class="secao secao--bege">
    <div class="container">
      <div class="cabecalho-secao">
        <div>
          <p class="eyebrow">Na trilha</p>
          <h2>Registros de quem já foi</h2>
        </div>
        <a class="link-seta" href={site.instagram} target="_blank" rel="noopener" data-track="click_instagram" data-local="galeria">Mais no Instagram</a>
      </div>
      <Galeria fotos={home.galeria} />
    </div>
  </section>

  <!-- QUEM CONDUZ --------------------------------------------------------------->
  {caio && (
    <section class="secao">
      <div class="container quem">
        <div class="quem-foto">
          <Foto src={caio.data.foto} alt={caio.data.fotoAlt} largura={700} sizes="(max-width: 820px) 100vw, 520px" />
        </div>
        <div>
          <p class="eyebrow">Quem conduz</p>
          <h2>{caio.data.nome}</h2>
          <p class="quem-cargo">{caio.data.cargo}</p>
          <ul class="lista-check">{caio.data.credenciais.map((c) => <li>{c}</li>)}</ul>
          <div class="parceria">
            <Foto src={sobre.parceria.logo} alt="Logo do Raceville Speed Club" largura={120} />
            <p><strong>Parceria Raceville Speed Club.</strong> Os treinamentos acontecem na pista off-road do clube, em Brotas-SP.</p>
          </div>
          <a class="link-seta" href="/a-keeptrack/">Conheça a KeepTrack</a>
        </div>
      </div>
    </section>
  )}

  <!-- BLOG ---------------------------------------------------------------------->
  {posts.length > 0 && (
    <section class="secao secao--bege">
      <div class="container">
        <div class="cabecalho-secao">
          <div>
            <p class="eyebrow">Blog</p>
            <h2>Dicas e relatos</h2>
          </div>
          <a class="link-seta" href="/blog/">Ver todos os posts</a>
        </div>
        <div class="grade">{posts.map((p) => <CardPost post={p} />)}</div>
      </div>
    </section>
  )}

  <CTAFinal />
</BaseLayout>

<style>
  /* Hero */
  .hero { position: relative; isolation: isolate; min-height: min(94vh, 860px); display: flex; align-items: flex-end; color: #e6ecf8; overflow: hidden; background: var(--azul-escuro); }
  .hero-foto { position: absolute; inset: 0; z-index: -1; }
  .hero-foto :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .hero-foto::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(18 29 61 / .92) 0%, rgb(18 29 61 / .72) 42%, rgb(18 29 61 / .15) 75%),
      linear-gradient(0deg, rgb(18 29 61 / .9) 0%, transparent 45%);
  }
  .hero-conteudo { padding-block: clamp(72px, 12vw, 140px) clamp(120px, 12vw, 170px); }
  .hero h1 { color: #fff; max-width: 14ch; margin-bottom: .3em; text-shadow: 0 2px 30px rgb(0 0 0 / .25); }
  .hero h1, .hero-sub, .hero-botoes, .chip-turma, .hero .eyebrow { animation: subir .9s var(--ease) both; }
  .hero-sub { animation-delay: .08s; } .hero-botoes { animation-delay: .16s; } .chip-turma { animation-delay: .24s; }
  @keyframes subir { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .hero h1, .hero-sub, .hero-botoes, .chip-turma, .hero .eyebrow { animation: none; } }
  .hero-sub { font-size: clamp(1.1rem, 1.7vw, 1.3rem); max-width: 52ch; margin-bottom: 2rem; }
  .hero-botoes { display: flex; flex-wrap: wrap; gap: .8rem; }
  .chip-turma {
    display: inline-flex; align-items: center; gap: .9rem; margin-top: 2.2rem; padding: .55rem 1.1rem .55rem .55rem;
    background: rgb(255 255 255 / .1); border: 1px solid rgb(255 255 255 / .22); border-radius: 999px;
    color: #fff; text-decoration: none; backdrop-filter: blur(6px); line-height: 1.25; font-size: .98rem;
  }
  .chip-turma:hover { background: rgb(255 255 255 / .18); color: #fff; }
  .chip-turma small { display: block; font-size: .78rem; letter-spacing: .14em; text-transform: uppercase; color: #9fb6e6; font-weight: 600; }
  .chip-data { width: 52px; height: 52px; border-radius: 50%; background: var(--azul); display: grid; place-content: center; text-align: center; font-family: var(--f-titulo); text-transform: uppercase; font-size: .72rem; letter-spacing: .06em; line-height: 1; }
  .chip-data strong { font-size: 1.35rem; display: block; }

  .faixa-aut { position: relative; z-index: 2; margin-top: calc(-1 * clamp(70px, 8vw, 100px)); }
  .faixa-card {
    background: linear-gradient(135deg, #24397a 0%, var(--azul-escuro) 60%);
    border-radius: var(--raio-g); padding: clamp(.4rem, 1.5vw, 1rem) clamp(1.2rem, 3vw, 2.4rem);
    box-shadow: var(--sombra-forte), inset 0 0 0 1px rgb(255 255 255 / .08); overflow: hidden;
  }

  /* Caminhos */
  .caminhos { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2.4vw, 28px); }
  .caminho { position: relative; display: block; aspect-ratio: 5 / 4; border-radius: calc(var(--raio-g) + 4px); overflow: hidden; color: #fff; text-decoration: none; isolation: isolate; box-shadow: var(--sombra); transition: box-shadow .4s, transform .4s var(--ease); }
  .caminho:hover { box-shadow: var(--sombra-forte); transform: translateY(-4px); }
  .caminho-seta { position: absolute; right: clamp(1.4rem, 3vw, 2.4rem); bottom: clamp(1.4rem, 3vw, 2.4rem); width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: rgb(255 255 255 / .14); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .25); transition: background-color .3s, transform .3s var(--ease); }
  .caminho-seta :global(svg) { width: 22px; }
  .caminho:hover .caminho-seta { background: var(--azul); transform: rotate(-45deg); }
  .caminho .link-seta { display: none; }
  .caminho :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform .7s; }
  .caminho::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(18 29 61 / .95) 0%, rgb(18 29 61 / .45) 50%, rgb(18 29 61 / .1) 100%); }
  .caminho:hover :global(img) { transform: scale(1.05); }
  .caminho-texto { position: absolute; left: 0; right: 0; bottom: 0; padding: clamp(1.4rem, 3vw, 2.4rem); padding-right: calc(clamp(1.4rem, 3vw, 2.4rem) + 64px); }
  .caminho-num { font-family: var(--f-titulo); font-weight: 700; color: #9fb6e6; letter-spacing: .14em; }
  .caminho h3 { color: #fff; font-size: clamp(1.9rem, 3.4vw, 2.8rem); margin: .2rem 0 .4rem; }
  .caminho p { max-width: 42ch; color: #dfe6f5; }
  .caminho .link-seta { color: #fff; }
  .caminho:hover { color: #fff; }

  .agenda { margin-bottom: clamp(32px, 4vw, 48px); }

  /* Pilares */
  .pilares { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 3vw, 40px); }
  .pilares li { padding: clamp(1.4rem, 2.5vw, 2rem); border-radius: var(--raio-g); background: rgb(255 255 255 / .05); box-shadow: inset 0 0 0 1px var(--borda-vidro); backdrop-filter: blur(6px); transition: background-color .3s, transform .3s var(--ease); }
  .pilares li:hover { background: rgb(255 255 255 / .08); transform: translateY(-3px); }
  .pilar-icone { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 16px; background: linear-gradient(135deg, var(--azul), #2c4f97); color: #fff; margin-bottom: 1.3rem; box-shadow: 0 10px 20px -10px rgb(63 104 185 / .8); }
  .pilar-icone :global(svg) { width: 28px; }
  .pilares h3 { font-size: 1.7rem; }
  .pilares p { color: #c5d0ea; margin: 0; }
  .frota { margin-top: clamp(40px, 5vw, 64px); padding: 1.5rem 1.6rem; border: 1px solid rgb(255 255 255 / .14); border-radius: var(--raio-g); display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: center; }
  .frota-titulo { font-family: var(--f-titulo); font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: #fff; margin: 0; font-size: 1.1rem; }
  .frota ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .frota li { padding: .35em .9em; border-radius: 999px; background: rgb(255 255 255 / .08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .1); font-size: .95rem; color: #dfe6f5; }

  .aviso-agenda { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; padding: 1.3rem 1.5rem; margin-bottom: clamp(24px, 3vw, 40px); background: var(--bege); border-radius: var(--raio-g); box-shadow: inset 0 0 0 1px var(--bege-2); }
  .aviso-agenda > :global(svg) { width: 36px; color: var(--azul); flex: none; }
  .aviso-agenda p { margin: 0; flex: 1 1 320px; }

  /* Quem conduz */
  .quem { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .quem-foto { aspect-ratio: 4 / 5; border-radius: var(--raio-g); overflow: hidden; background: var(--bege-2); }
  .quem-foto :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 62% center; }
  .quem h2 { margin-bottom: .1em; }
  .quem-cargo { font-family: var(--f-titulo); font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--azul); margin-bottom: 1.4rem; }
  .parceria { display: flex; gap: 1rem; align-items: center; margin: 2rem 0 1.6rem; padding: 1rem; border: 1px solid var(--linha); border-radius: var(--raio-g); }
  .parceria :global(img) { width: 88px; height: auto; border-radius: var(--raio); flex: none; }
  .parceria p { margin: 0; font-size: .98rem; }

  @media (max-width: 900px) {
    .pilares { grid-template-columns: 1fr; }
    .quem { grid-template-columns: 1fr; }
    .quem-foto { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 820px) {
    .caminhos { grid-template-columns: 1fr; }
    .caminho { aspect-ratio: 4 / 3.4; }
  }
  @media (max-width: 600px) {
    .hero { min-height: 0; }
    .hero-foto :global(img) { object-position: 70% 50%; }
    .hero-foto::after { background: linear-gradient(0deg, rgb(18 29 61 / .96) 15%, rgb(18 29 61 / .55) 70%, rgb(18 29 61 / .35) 100%); }
    .hero-conteudo { padding-top: 180px; padding-bottom: 110px; }
    .hero-botoes .btn { flex: 1 1 100%; }
  }
</style>

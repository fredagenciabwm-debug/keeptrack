---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Foto from '../components/Foto.astro';
import Icone from '../components/Icone.astro';
import CardEquipe from '../components/CardEquipe.astro';
import FaixaAutoridade from '../components/FaixaAutoridade.astro';
import CTAFinal from '../components/CTAFinal.astro';
import { schemaBreadcrumb, schemaPessoa } from '../lib/schema';

const s = (await getEntry('sobre', 'a-keeptrack'))!.data;
const home = (await getEntry('home', 'home'))!.data;
const equipe = (await getCollection('equipe')).sort((a, b) => a.data.ordem - b.data.ordem);
const migalhas = [{ nome: 'Início', url: '/' }, { nome: 'A KeepTrack', url: '/a-keeptrack/' }];
const iconeServico = (i: number) => (['escudo', 'rota', 'pessoas', 'ferramenta'] as const)[i % 4];
const schema = [
  schemaBreadcrumb(migalhas, Astro.site!),
  { '@type': 'AboutPage', name: s.titulo, url: new URL('/a-keeptrack/', Astro.site).href, about: { '@id': new URL('/#organizacao', Astro.site).href } },
  ...equipe.map((e) => schemaPessoa(e.data, e.data.foto, Astro.site!)),
];
---
<BaseLayout titulo={s.seo.titulo} descricao={s.seo.descricao} imagem={s.capa} preloadImagem={s.capa} schema={schema}>
  <PageHero titulo={s.titulo} eyebrow="Quem somos" subtitulo={s.subtitulo} imagem={s.capa} imagemAlt={s.capaAlt} migalhas={migalhas} />

  <section class="secao">
    <div class="container historia">
      <div>
        <p class="eyebrow">Nossa história</p>
        <h2>Nascemos na estrada</h2>
      </div>
      <div class="prosa">{s.historia.split(/\n\s*\n/).map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section class="secao--escura topo faixa"><div class="container"><FaixaAutoridade numeros={home.numeros} /></div></section>

  <section class="secao secao--bege">
    <div class="container">
      <div class="cabecalho-secao"><div><p class="eyebrow">O que fazemos</p><h2>Serviços</h2></div></div>
      <ul class="servicos">
        {s.servicos.map((sv, i) => (
          <li><span class="ic"><Icone nome={iconeServico(i)} /></span><h3>{sv.titulo}</h3><p>{sv.texto}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="secao" id="equipe">
    <div class="container">
      <div class="cabecalho-secao"><div><p class="eyebrow">Equipe</p><h2>Quem conduz</h2></div></div>
      <div class="equipe">{equipe.map((e) => <CardEquipe pessoa={e} />)}</div>
    </div>
  </section>

  <section class="secao secao--escura topo">
    <div class="container frota">
      <div class="frota-foto"><Foto src={s.frotaImagem} alt={s.frotaImagemAlt} largura={800} sizes="(max-width: 820px) 100vw, 560px" /></div>
      <div>
        <p class="eyebrow">Frota e equipamentos</p>
        <h2>Preparados para o imprevisto</h2>
        <p>Os veículos de apoio da KeepTrack levam o equipamento para resolver atolamentos, panes e longos trechos sem estrutura:</p>
        <ul class="itens">{s.frota.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container parceria">
      <Foto src={s.parceria.logo} alt="Logo do Raceville Speed Club" largura={240} />
      <div>
        <p class="eyebrow">Parceria</p>
        <h2>{s.parceria.titulo}</h2>
        <p>{s.parceria.texto}</p>
        <a class="link-seta" href="/treinamentos/">Ver treinamentos</a>
      </div>
    </div>
  </section>

  <CTAFinal />
</BaseLayout>
<style>
  .historia { display: grid; grid-template-columns: 1fr 1.5fr; gap: 2rem 5rem; }
  .faixa { padding-block: clamp(20px, 3vw, 36px); }
  .servicos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2vw, 24px); }
  .servicos li { background: var(--branco); padding: 1.6rem; border-radius: var(--raio-g); box-shadow: var(--sombra); }
  .ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--bege); color: var(--azul); margin-bottom: 1rem; }
  .ic :global(svg) { width: 26px; }
  .servicos h3 { font-size: 1.5rem; }
  .servicos p { margin: 0; color: var(--cinza); }
  .equipe { display: grid; gap: 4rem; }
  .frota { display: grid; grid-template-columns: 1fr 1.1fr; gap: 2rem 4rem; align-items: center; }
  .frota-foto { aspect-ratio: 4 / 3; border-radius: var(--raio-g); overflow: hidden; }
  .frota-foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .frota p { color: #c5d0ea; }
  .itens { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: .6rem 1.5rem; }
  .itens li { padding-left: 1.4em; position: relative; color: #fff; font-weight: 500; }
  .itens li::before { content: ''; position: absolute; left: 0; top: .6em; width: .75em; height: 2px; background: var(--azul); }
  .parceria { display: grid; grid-template-columns: 220px 1fr; gap: 2rem 3.5rem; align-items: center; max-width: 960px; }
  .parceria :global(img) { border-radius: var(--raio-g); width: 100%; }
  @media (max-width: 960px) { .servicos { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 820px) { .historia, .frota { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .servicos, .itens { grid-template-columns: 1fr; } .parceria { grid-template-columns: 1fr; } .parceria :global(img) { width: 160px; } }
</style>

---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import { getSite, linkWhatsApp } from '../lib/utils';

interface Props { whatsappTexto?: string; rotuloProduto?: string }
const { whatsappTexto, rotuloProduto } = Astro.props;
const site = await getSite();
const wa = linkWhatsApp(site.whatsappPrincipal, whatsappTexto ?? site.whatsappTexto);

const menu = [
  { href: '/treinamentos/', rotulo: 'Treinamentos' },
  { href: '/viagens/', rotulo: 'Viagens & Expedições' },
  { href: '/a-keeptrack/', rotulo: 'A KeepTrack' },
  { href: '/blog/', rotulo: 'Blog' },
  { href: '/contato/', rotulo: 'Contato' },
];
const atual = Astro.url.pathname;
const ativo = (href: string) => atual === href || (href !== '/' && atual.startsWith(href));
---
<header class="topo-site">
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <div class="container barra">
    <a href="/" class="marca" aria-label="KeepTrack 4x4 — página inicial">
      <Logo />
    </a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {menu.map((m) => (
          <li><a href={m.href} aria-current={ativo(m.href) ? 'page' : undefined}>{m.rotulo}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--wa wa-topo" href={wa} target="_blank" rel="noopener" aria-label="Falar no WhatsApp"
       data-track="click_whatsapp" data-local="header" data-produto={rotuloProduto}>
      <Icone nome="whatsapp" /><span>WhatsApp</span>
    </a>

    <details class="nav-mobile">
      <summary aria-label="Abrir menu">
        <Icone nome="menu" class="i-abrir" /><Icone nome="fechar" class="i-fechar" />
      </summary>
      <nav aria-label="Principal (celular)">
        <ul>
          <li><a href="/" aria-current={atual === '/' ? 'page' : undefined}>Início</a></li>
          {menu.map((m) => (
            <li><a href={m.href} aria-current={ativo(m.href) ? 'page' : undefined}>{m.rotulo}</a></li>
          ))}
        </ul>
        <a class="btn btn--wa btn--bloco" href={wa} target="_blank" rel="noopener"
           data-track="click_whatsapp" data-local="menu-mobile" data-produto={rotuloProduto}>
          <Icone nome="whatsapp" />Falar no WhatsApp
        </a>
      </nav>
    </details>
  </div>
</header>

<style>
  .topo-site {
    position: sticky; top: 0; z-index: 50;
    background: var(--azul-escuro);
    color: var(--branco);
    border-bottom: 1px solid rgb(255 255 255 / .08);
  }
  .pular { position: absolute; left: -999px; top: 8px; background: var(--branco); color: var(--azul-escuro); padding: .5em 1em; z-index: 60; }
  .pular:focus { left: 8px; }
  .barra { display: flex; align-items: center; gap: 1.5rem; height: 76px; }
  .marca { width: 150px; color: var(--branco); flex: none; }
  .marca:hover { color: #cfdcf6; }

  .nav-desktop { margin-left: auto; }
  .nav-desktop ul { display: flex; gap: clamp(.9rem, 2vw, 2rem); list-style: none; margin: 0; padding: 0; }
  .nav-desktop a, .nav-mobile li a {
    font-family: var(--f-titulo); font-weight: 600; font-size: 1.12rem; letter-spacing: .07em; text-transform: uppercase;
    color: #dfe6f5; text-decoration: none; padding: .4em 0; position: relative;
  }
  .nav-desktop a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--azul); transform: scaleX(0); transform-origin: left; transition: transform .25s; }
  .nav-desktop a:hover, .nav-desktop a[aria-current] { color: var(--branco); }
  .nav-desktop a:hover::after, .nav-desktop a[aria-current]::after { transform: scaleX(1); }

  .wa-topo { min-height: 42px; padding: .45em 1.1em; font-size: 1rem; }

  .nav-mobile { display: none; }

  @media (max-width: 1040px) {
    .nav-desktop { display: none; }
    .wa-topo { margin-left: auto; }
    .nav-mobile { display: block; }
    .nav-mobile summary {
      list-style: none; cursor: pointer; width: 46px; height: 46px; display: grid; place-items: center;
      border-radius: var(--raio); border: 1px solid rgb(255 255 255 / .25);
    }
    .nav-mobile summary::-webkit-details-marker { display: none; }
    .nav-mobile summary svg { width: 24px; }
    .i-fechar { display: none; }
    .nav-mobile[open] .i-fechar { display: block; }
    .nav-mobile[open] .i-abrir { display: none; }
    .nav-mobile nav {
      position: absolute; left: 0; right: 0; top: 76px;
      background: var(--azul-escuro); padding: 1rem var(--gutter) 1.5rem;
      border-top: 1px solid rgb(255 255 255 / .1); box-shadow: 0 20px 30px -10px rgb(0 0 0 / .4);
      max-height: calc(100dvh - 76px); overflow: auto;
    }
    .nav-mobile ul { list-style: none; margin: 0 0 1.25rem; padding: 0; }
    .nav-mobile li a { display: block; padding: .85em 0; font-size: 1.35rem; border-bottom: 1px solid rgb(255 255 255 / .08); }
    .nav-mobile li a[aria-current] { color: var(--branco); box-shadow: inset 3px 0 0 var(--azul); padding-left: .8em; }
  }
  @media (max-width: 480px) {
    .barra { gap: .75rem; height: 68px; }
    .marca { width: 118px; }
    .wa-topo span { display: none; }
    .wa-topo { width: 46px; height: 46px; padding: 0; }
    .nav-mobile nav { top: 68px; }
  }
</style>

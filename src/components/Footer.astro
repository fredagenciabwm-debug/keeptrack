---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import { getSite, linkWhatsApp, formatarTelefone } from '../lib/utils';
const site = await getSite();
const ano = new Date().getFullYear();
---
<footer class="rodape topo">
  <div class="container grade-rodape">
    <div class="col-marca">
      <a href="/" class="logo-rodape" aria-label="KeepTrack 4x4 — página inicial"><Logo /></a>
      <p>Treinamentos de condução 4x4 e expedições off-road com segurança, técnica e apoio em cada quilômetro.</p>
      <div class="redes">
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram da KeepTrack" data-track="click_instagram" data-local="footer"><Icone nome="instagram" /></a>
        <a href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook da KeepTrack" data-track="click_facebook" data-local="footer"><Icone nome="facebook" /></a>
      </div>
    </div>

    <nav aria-label="Rodapé">
      <h2>Navegue</h2>
      <ul>
        <li><a href="/treinamentos/">Treinamentos</a></li>
        <li><a href="/treinamentos/corporativo/">Para empresas</a></li>
        <li><a href="/viagens/">Viagens & Expedições</a></li>
        <li><a href="/a-keeptrack/">A KeepTrack</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/contato/">Contato</a></li>
      </ul>
    </nav>

    <div>
      <h2>Fale com a gente</h2>
      <ul class="contatos">
        <li><Icone nome="whatsapp" /><a href={linkWhatsApp(site.whatsappPrincipal, site.whatsappTexto)} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="footer">{formatarTelefone(site.whatsappPrincipal)}</a></li>
        {site.whatsappSecundario && (
          <li><Icone nome="whatsapp" /><a href={linkWhatsApp(site.whatsappSecundario, site.whatsappTexto)} target="_blank" rel="noopener" data-track="click_whatsapp" data-local="footer-2">{formatarTelefone(site.whatsappSecundario)}</a></li>
        )}
        <li><Icone nome="email" /><a href={`mailto:${site.email}`} data-track="click_email" data-local="footer">{site.email}</a></li>
        <li><Icone nome="local" /><span>Treinamentos no {site.local.nome}, {site.cidade}-{site.uf}</span></li>
      </ul>
    </div>
  </div>

  <div class="container base">
    <p>© {ano} KeepTrack 4x4. Todos os direitos reservados.</p>
    <p>
      <a href="/politica-de-privacidade/">Privacidade e cookies</a>
      <button type="button" class="link-cookies" data-cc="show-preferencesModal">Preferências de cookies</button>
    </p>
  </div>
</footer>

<style>
  .rodape { background: var(--azul-noite); color: #c5d0ea; padding: clamp(56px, 7vw, 88px) 0 28px; font-size: 1rem; }
  .grade-rodape { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: 2.5rem 3rem; }
  .logo-rodape { display: block; width: 170px; color: var(--branco); margin-bottom: 1.25rem; }
  .col-marca p { max-width: 34ch; }
  .rodape h2 { font-size: 1.15rem; letter-spacing: .14em; color: var(--branco); margin-bottom: 1.1rem; }
  .rodape ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; }
  .rodape a { color: #dfe6f5; text-decoration: none; }
  .rodape a:hover { color: var(--branco); text-decoration: underline; }
  .contatos li { display: flex; gap: .7em; align-items: flex-start; }
  .contatos svg { width: 20px; flex: none; margin-top: .2em; color: #9fb6e6; }
  .redes { display: flex; gap: .6rem; margin-top: 1.25rem; }
  .redes a { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid rgb(255 255 255 / .2); border-radius: 50%; }
  .redes a:hover { background: var(--azul); border-color: var(--azul); }
  .redes svg { width: 20px; }
  .base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem; margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / .1); font-size: .92rem; }
  .base p { margin: 0; display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .link-cookies { background: none; border: 0; padding: 0; color: #dfe6f5; cursor: pointer; text-decoration: underline; text-underline-offset: .18em; }
  @media (max-width: 820px) { .grade-rodape { grid-template-columns: 1fr 1fr; } .col-marca { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .grade-rodape { grid-template-columns: 1fr; } }
</style>

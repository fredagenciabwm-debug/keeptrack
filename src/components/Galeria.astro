---
import Foto from './Foto.astro';
interface Props { fotos: { src: string; alt: string }[]; id?: string }
const { fotos, id = 'galeria' } = Astro.props;
---
<div class="galeria" data-galeria id={id}>
  {fotos.map((f, i) => (
    <button type="button" class:list={['item', { destaque: i === 0 && fotos.length % 4 === 1 }]} data-indice={i} aria-label={`Ampliar foto: ${f.alt}`}>
      <Foto src={f.src} alt={f.alt} largura={800} sizes="(max-width: 720px) 50vw, 400px" />
    </button>
  ))}
  <dialog class="caixa" aria-label="Foto ampliada">
    <img alt="" />
    <p class="legenda"></p>
    <button type="button" class="fechar" aria-label="Fechar">×</button>
    <button type="button" class="ant" aria-label="Foto anterior">‹</button>
    <button type="button" class="prox" aria-label="Próxima foto">›</button>
  </dialog>
</div>
<script>
  // Lightbox leve com <dialog>, sem biblioteca
  document.querySelectorAll<HTMLElement>('[data-galeria]').forEach((g) => {
    const dlg = g.querySelector('dialog')!;
    const img = dlg.querySelector('img')!;
    const leg = dlg.querySelector('.legenda')!;
    const itens = [...g.querySelectorAll<HTMLButtonElement>('.item')];
    let atual = 0;
    const mostrar = (i: number) => {
      atual = (i + itens.length) % itens.length;
      const fonte = itens[atual].querySelector('img')!;
      img.src = fonte.currentSrc || fonte.src;
      img.alt = fonte.alt;
      leg.textContent = fonte.alt;
    };
    itens.forEach((b, i) => b.addEventListener('click', () => { mostrar(i); dlg.showModal(); }));
    dlg.querySelector('.fechar')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('.ant')!.addEventListener('click', () => mostrar(atual - 1));
    dlg.querySelector('.prox')!.addEventListener('click', () => mostrar(atual + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(atual - 1);
      if (e.key === 'ArrowRight') mostrar(atual + 1);
    });
  });
</script>
<style>
  .galeria { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: clamp(120px, 16vw, 210px); gap: 10px; }
  .item { padding: 0; border: 0; border-radius: 16px; overflow: hidden; cursor: zoom-in; background: var(--bege-2); }
  .item :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease), filter .4s; }
  .item:hover :global(img) { transform: scale(1.05); }
  .destaque { grid-column: span 2; grid-row: span 2; }
  @media (max-width: 720px) { .galeria { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 150px; } }
  .caixa { border: 0; padding: 0; background: transparent; max-width: min(1100px, 94vw); max-height: 92vh; overflow: visible; }
  .caixa::backdrop { background: rgb(10 16 34 / .92); }
  .caixa img { max-height: 82vh; width: auto; margin-inline: auto; border-radius: var(--raio); }
  .legenda { color: #dfe6f5; text-align: center; margin: .8rem 0 0; }
  .caixa button { position: fixed; background: rgb(255 255 255 / .12); color: #fff; border: 0; width: 52px; height: 52px; border-radius: 50%; font-size: 2rem; line-height: 1; cursor: pointer; }
  .caixa button:hover { background: var(--azul); }
  .fechar { top: 16px; right: 16px; }
  .ant { left: 16px; top: 50%; translate: 0 -50%; }
  .prox { right: 16px; top: 50%; translate: 0 -50%; }
</style>

---
import Foto from './Foto.astro';
import Icone from './Icone.astro';
import { periodo, rotulos, statusEfetivo, dias, type Viagem } from '../lib/utils';
interface Props { viagem: Viagem; nivelTitulo?: 'h2' | 'h3' }
const { viagem: v, nivelTitulo = 'h3' } = Astro.props;
const d = v.data;
const status = statusEfetivo(v);
const realizada = status === 'realizada';
const H = nivelTitulo;
---
<article class="card-viagem">
  <div class="midia">
    <Foto src={d.capa} alt={d.capaAlt} largura={640} sizes="(max-width: 720px) 100vw, 400px" />
    <span class:list={['selo', status === 'realizada' ? 'selo--foto' : `selo--${status}`]}>{rotulos.statusViagem[status]}</span>
  </div>
  <div class="corpo">
    <p class="quando"><Icone nome="calendario" />{periodo(d.inicio, d.fim, realizada)}{!realizada && <> · {dias(d.inicio, d.fim)} dias</>}</p>
    <H class="titulo"><a href={`/viagens/${v.id}/`}>{d.titulo}</a></H>
    <p class="destinos">{d.destinos.join(' · ')}</p>
    <ul class="fatos">
      <li><Icone nome="nivel" />Nível {rotulos.dificuldade[d.dificuldade].toLowerCase()}</li>
      <li><Icone nome="carro" />{d.veiculo}</li>
    </ul>
    <span class="link-seta" aria-hidden="true">{realizada ? 'Ver como foi' : 'Ver roteiro'}</span>
  </div>
</article>
<style>
  .card-viagem { position: relative; display: flex; flex-direction: column; background: var(--branco); border-radius: calc(var(--raio-g) + 4px); padding: 8px; box-shadow: var(--sombra), inset 0 0 0 1px rgb(18 29 61 / .05); transition: transform .35s var(--ease), box-shadow .35s; }
  .card-viagem:hover { transform: translateY(-4px); box-shadow: var(--sombra-forte); }
  .midia { position: relative; aspect-ratio: 16 / 10; background: var(--bege-2); overflow: hidden; border-radius: var(--raio-g); }
  .midia :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .card-viagem:hover .midia :global(img) { transform: scale(1.04); }
  .midia .selo { position: absolute; top: 12px; left: 12px; box-shadow: 0 4px 14px -6px rgb(0 0 0 / .35); }
  .corpo { padding: 1.2rem 1rem 1rem; display: flex; flex-direction: column; flex: 1; }
  .quando { display: flex; align-items: center; gap: .45em; font-size: .95rem; font-weight: 600; color: var(--azul); margin: 0 0 .5rem; text-transform: capitalize; }
  .quando :global(svg) { width: 18px; }
  .titulo { font-size: 1.75rem; margin: 0 0 .3rem; }
  .titulo a { color: inherit; text-decoration: none; }
  .titulo a::after { content: ''; position: absolute; inset: 0; }
  .destinos { color: var(--cinza); margin: 0 0 1rem; }
  .fatos { list-style: none; padding: 0; margin: 0 0 1.2rem; display: grid; gap: .35rem; font-size: .95rem; }
  .fatos li { display: flex; gap: .5em; align-items: center; }
  .fatos :global(svg) { width: 18px; color: var(--azul); flex: none; }
  .link-seta { margin-top: auto; color: var(--azul); padding-top: .9rem; border-top: 1px solid var(--linha); }
</style>

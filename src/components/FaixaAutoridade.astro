---
interface Props { numeros: { valor: string; rotulo: string }[] }
const { numeros } = Astro.props;
---
<ul class="faixa">
  {numeros.map((n) => (
    <li><span class="valor">{n.valor}</span><span class="rotulo">{n.rotulo}</span></li>
  ))}
</ul>
<style>
  .faixa { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  li { padding: 1.6rem 1.4rem; border-left: 1px solid rgb(255 255 255 / .14); }
  li:first-child { border-left: 0; padding-left: 0; }
  .valor { display: block; font-family: var(--f-titulo); font-weight: 700; font-size: clamp(2.6rem, 5vw, 3.8rem); line-height: 1; color: #fff; }
  .rotulo { display: block; margin-top: .4rem; color: #c5d0ea; font-size: 1rem; max-width: 22ch; }
  @media (max-width: 820px) {
    .faixa { grid-template-columns: 1fr 1fr; }
    li { padding: 1.2rem 1rem; }
    li:nth-child(odd) { border-left: 0; padding-left: 0; }
    li:nth-child(n+3) { border-top: 1px solid rgb(255 255 255 / .14); }
  }
</style>

---
import Foto from './Foto.astro';
import { dataLonga, rotulos, type Post } from '../lib/utils';
interface Props { post: Post; nivelTitulo?: 'h2' | 'h3' }
const { post: p, nivelTitulo = 'h3' } = Astro.props;
const H = nivelTitulo;
---
<article class="card-post">
  <div class="midia"><Foto src={p.data.capa} alt={p.data.capaAlt} largura={640} sizes="(max-width: 720px) 100vw, 400px" /></div>
  <div class="corpo">
    <p class="meta"><span class="cat">{rotulos.categoria[p.data.categoria]}</span> · <time datetime={p.data.publicado.toISOString()}>{dataLonga(p.data.publicado)}</time></p>
    <H class="titulo"><a href={`/blog/${p.id}/`}>{p.data.titulo}</a></H>
    <p class="resumo">{p.data.resumo}</p>
  </div>
</article>
<style>
  .card-post { position: relative; display: flex; flex-direction: column; }
  .midia { aspect-ratio: 16 / 10; border-radius: calc(var(--raio-g) + 4px); overflow: hidden; box-shadow: var(--sombra); background: var(--bege-2); margin-bottom: 1.1rem; }
  .midia :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .card-post:hover .midia :global(img) { transform: scale(1.04); }
  .meta { font-size: .9rem; color: var(--cinza); margin: 0 0 .45rem; }
  .cat { font-weight: 600; color: var(--azul); background: rgb(63 104 185 / .1); padding: .15em .65em; border-radius: var(--raio-pill); }
  .titulo { font-size: 1.6rem; margin: 0 0 .5rem; text-transform: none; font-weight: 700; letter-spacing: 0; }
  .titulo a { color: inherit; text-decoration: none; }
  .titulo a::after { content: ''; position: absolute; inset: 0; }
  .card-post:hover .titulo a { color: var(--azul); }
  .resumo { color: var(--cinza); margin: 0; }
</style>
